rules_version = '2';

// Mohlare Firestore security rules.
// Paste these into Firebase console → Firestore Database → Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each learner can only read and write their own profile and everything under it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared data: any signed-in learner can read it. Only you change it, from the Firebase console.
    match /universities/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /courses/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /bursaries/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /themes/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
